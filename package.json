{
  "name": "sarafa-app",
  "version": "1.0.0",
  "description": "حاسبة الصيرفة: دينار عراقي، ليرة تركية، دولار",
  "main": "electron/main.js",
  "author": "ALRAWE75",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "rates": "node scripts/update-rates.mjs",
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.alrawe75.sarafa",
    "productName": "Sarafa",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["electron/**/*", "www/**/*", "package.json"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "Sarafa-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Sarafa-Portable-${version}.${ext}"
    }
  }
}
